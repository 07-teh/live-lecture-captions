# Copy to .env (start.command does this on first run) and fill in your own keys.
# Never commit .env.

# Deepgram does the live speech-to-text. Required for recording.
STT_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=en
STT_API_URL=https://api.deepgram.com/v1/listen
STT_STREAM_API_URL=wss://api.deepgram.com/v1/listen
STT_ENDPOINTING_MS=300
STT_UTTERANCE_END_MS=1000
STT_SAMPLE_RATE=16000
# Optional comma-separated terms Deepgram should listen for (course terms are added automatically).
STT_KEYTERMS=

# DeepSeek does the live English→Chinese translation. Leave the key empty to turn translation off.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Leave empty to keep history next to backend.py.
HISTORY_DB_PATH=
